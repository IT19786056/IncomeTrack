# Copy to .env and fill in from your Firebase project settings.
# Every VITE_-prefixed variable is bundled into the client and is publicly
# readable — never put a secret here that isn't safe to expose.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave blank to use the project's default Firestore database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# The first admin account. Must match the literal in firestore.rules,
# which cannot read environment variables.
VITE_ADMIN_EMAIL=

# Optional: enables the AI suggestions panel.
# WARNING: this key ships in the client bundle and can be extracted by anyone
# with the deployed JavaScript. Move it behind a server endpoint before
# sharing the app publicly.
VITE_GEMINI_API_KEY=
